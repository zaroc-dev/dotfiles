// Laptop Monitors

output "eDP-1" {
    mode "1920x1080@60.00"
    scale 1.0
    position x=1920 y=0
}

output "DP-5" {
	position x=-1920 y=0
    focus-at-startup
    transform "180"
}

output "DP-4" {
	mode "1920x1080@144"
	position x=0 y=0
    transform "180"
}

// Desktop Monitors

output "DP-1" {
    mode "2560x1440@300.000"
    position x=0 y=0
    focus-at-startup
}

output "HDMI-A-1" {
    mode "1920x1080@144"
    position x=-1920 y=0
}

